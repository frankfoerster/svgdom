{
  "name": "@frankfoerster/svgdom",
  "version": "0.1.29",
  "description": "Straightforward DOM implementation for SVG, HTML and XML",
  "keywords": [
    "dom",
    "nodejs",
    "svgdom",
    "svgjs",
    "xml",
    "xmldom"
  ],
  "homepage": "https://github.com/svgdotjs/svgdom#readme",
  "bugs": {
    "url": "https://github.com/svgdotjs/svgdom/issues"
  },
  "license": "MIT",
  "author": "Ulrich-Matthias Schäfer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svgdotjs/svgdom.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Fuzzyma"
  },
  "files": [
    "dist",
    "LICENSE.txt",
    "readme.md",
    "src"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    "types": "./dist/src/index.d.ts",
    "import": "./dist/src/index.js",
    "require": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-fonts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:package": "npm run build && tsc -p tsconfig.package.json && node scripts/test-package.mjs"
  },
  "dependencies": {
    "@carboneio/image-size": "^3.0.0",
    "@types/node": "^22.0.0",
    "fontkit": "^2.0.4",
    "sax": "^1.4.1"
  },
  "devDependencies": {
    "@svgdotjs/svg.js": "^3.2.0",
    "@types/fontkit": "^2.0.8",
    "@types/sax": "^1.2.7",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
